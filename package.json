{
  "name": "marketplace-hub",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "pnpm --filter @marketplace-hub/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @marketplace-hub/api db:generate",
    "db:migrate": "pnpm --filter @marketplace-hub/api db:migrate",
    "db:studio": "pnpm --filter @marketplace-hub/api db:studio"
  },
  "devDependencies": {
    "typescript": "~5.8.0"
  }
}
