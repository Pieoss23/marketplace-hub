{
  "manifest_version": 3,
  "name": "Marketplace Hub — Copia annuncio (MVP validazione)",
  "version": "0.1.0",
  "description": "Recupera un annuncio centrale da Marketplace Hub e ne copia i campi manualmente. Nessuna automazione su marketplace reali.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost:4300/*", "http://127.0.0.1:4300/*"],
      "js": ["content/demo-form-content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
