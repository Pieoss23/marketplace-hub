# --- API ---
API_PORT=3000
API_GLOBAL_PREFIX=api
CORS_ORIGIN=http://localhost:4200

# --- Auth ---
# Dev-only fallback exists in code; always set a real secret outside local dev.
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRES_IN_SECONDS=604800

# --- PostgreSQL (used by docker-compose.yml) ---
POSTGRES_USER=marketplace_hub
POSTGRES_PASSWORD=marketplace_hub
POSTGRES_DB=marketplace_hub
POSTGRES_PORT=5432

# --- Prisma ---
DATABASE_URL=postgresql://marketplace_hub:marketplace_hub@localhost:5432/marketplace_hub?schema=public
